---
import '../styles/global.css';
---

<div class="w-full max-w-md mx-auto my-8">
	<header class="text-center mb-8">
		<h1 class="text-4xl font-bold text-white tracking-tight">NumPlate</h1>
		<p class="text-slate-400 text-sm mt-2">Calculadora numérica de matrículas</p>
	</header>

	<div class="glass rounded-3xl p-6 shadow-2xl">
		<div class="flex justify-center gap-2 mb-6 bg-slate-800/50 p-1 rounded-xl">
			<button
				id="tabManual"
				type="button"
				class="flex-1 py-2 rounded-lg text-sm font-medium transition-colors bg-cyan-500 text-white"
			>
				Manual
			</button>
			<button
				id="tabCamera"
				type="button"
				class="flex-1 py-2 rounded-lg text-sm font-medium transition-colors text-slate-400 hover:text-white"
			>
				Foto
			</button>
		</div>

		<!-- Entrada Manual -->
		<form id="manualSection">
			<input
				type="text"
				id="plateInput"
				maxlength="7"
				placeholder="Ej: 9932AZG"
				autocomplete="off"
				class="w-full bg-slate-900/70 border border-slate-700 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 outline-none rounded-xl p-4 text-center text-2xl font-mono tracking-[0.3em] text-white uppercase placeholder-slate-600 placeholder:tracking-normal placeholder:font-sans placeholder:text-base"
				oninput="this.value = this.value.toUpperCase()"
			/>
			<div class="mt-4 grid grid-cols-[auto_1fr] gap-3">
				<button
					type="button"
					id="randomBtn"
					title="Generar una matrícula aleatoria"
					class="bg-slate-700 hover:bg-slate-600 text-white font-bold px-4 py-4 rounded-xl transition-colors active:scale-[0.98] flex items-center"
				>
					<svg
						class="w-6 h-6"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
						/>
					</svg>
				</button>
				<button
					type="submit"
					id="calcBtn"
					class="w-full bg-cyan-500 hover:bg-cyan-400 text-white font-bold py-4 rounded-xl transition-colors active:scale-[0.98] flex items-center justify-center gap-2"
				>
					<span>Calcular</span>
					<span class="text-xs bg-cyan-600/50 px-2 py-1 rounded-md">ENTER ⏎</span>
				</button>
			</div>
		</form>

		<!-- Entrada por Cámara -->
		<div id="cameraSection" class="hidden">
			<div class="border-2 border-dashed border-slate-700 rounded-xl p-8 text-center bg-slate-900/40">
				<svg
					class="w-12 h-12 mx-auto mb-4 text-slate-500"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"
					></path>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
				</svg>
				<p class="text-slate-400 mb-4 text-sm">Toma una foto clara de la matrícula</p>
				<input type="file" id="cameraInput" accept="image/*" capture="environment" class="hidden" />
				<button
					type="button"
					id="uploadBtn"
					class="bg-slate-700 hover:bg-slate-600 text-white font-bold py-3 px-6 rounded-xl transition-colors"
				>
					Subir / Hacer Foto
				</button>
			</div>
			<div id="loadingOcr" class="hidden flex-col items-center mt-6">
				<div class="loader mb-3"></div>
				<p class="text-cyan-400 text-sm animate-pulse">Leyendo matrícula...</p>
			</div>
			<img id="previewImg" alt="" class="hidden mt-4 rounded-xl max-h-40 mx-auto border border-slate-700" />
		</div>
	</div>

	<!-- RESULTADO GIGANTE DEBAJO DEL FORMULARIO -->
	<div id="resultContainer" class="hidden mt-8 text-center glass rounded-3xl p-8 shadow-2xl">
		<p class="text-slate-400 text-xs mb-4 uppercase tracking-[0.3em]">Tu Número Es</p>
		<div class="text-9xl font-black text-cyan-400 my-4 glow-text" id="resultNumber">0</div>
		<div class="mt-4 border-t border-slate-700/50 pt-4">
			<p class="text-slate-500 text-sm font-mono" id="platePreview"></p>
		</div>
	</div>

	<footer class="text-center mt-8 text-slate-600 text-xs">
		Sistema Español (4 Números + 3 Letras)
	</footer>
</div>

<script is:inline>
	// ==========================================
	// LÓGICA DE LA MATRÍCULA (TypeScript/JS)
	// ==========================================

	function calculatePlate(plate) {
		const cleanPlate = plate.toUpperCase().trim();
		if (cleanPlate.length !== 7) {
			throw new Error('La matrícula debe tener exactamente 7 caracteres.');
		}

		const numbersArray = [cleanPlate.at(-7), cleanPlate.at(-6), cleanPlate.at(-5), cleanPlate.at(-4)];
		const countOfNines = numbersArray.filter((n) => n === '9').length;

		const sumNumbers = (arr) => {
			return arr.reduce((acc, curr) => {
				const num = parseInt(curr, 10);
				if (num === 9) {
					if (countOfNines > 1) return acc;
					return acc + num;
				}
				return acc + num;
			}, 0);
		};

		let totalSum = sumNumbers(numbersArray);

		while (totalSum >= 10) {
			totalSum = totalSum
				.toString()
				.split('')
				.reduce((acc, digit) => acc + parseInt(digit, 10), 0);
		}

		return totalSum;
	}
	window.calculatePlate = calculatePlate;

	// ==========================================
	// MATRÍCULA ALEATORIA (4 dígitos + 3 letras)
	// Letras válidas en matrículas españolas (sin vocales, Ñ, Q)
	// ==========================================

	const SPANISH_PLATE_LETTERS = 'BCDFGHJKLMNPRSTVWXYZ';

	function randomDigit() {
		return Math.floor(Math.random() * 10);
	}

	function randomSpanishPlate() {
		const digits = Array.from({ length: 4 }, randomDigit).join('');
		let letters = '';
		for (let i = 0; i < 3; i++) {
			letters += SPANISH_PLATE_LETTERS.charAt(
				Math.floor(Math.random() * SPANISH_PLATE_LETTERS.length),
			);
		}
		return `${digits}${letters}`;
	}

	document.getElementById('randomBtn').addEventListener('click', () => {
		const plate = randomSpanishPlate();
		document.getElementById('plateInput').value = plate;
		processPlate(plate); // recalcula automáticamente
	});

	// ==========================================
	// INTERACCIÓN UI (DOM)
	// ==========================================

	const manualSection = document.getElementById('manualSection');
	const cameraSection = document.getElementById('cameraSection');
	const tabManual = document.getElementById('tabManual');
	const tabCamera = document.getElementById('tabCamera');

	tabManual.addEventListener('click', () => {
		manualSection.classList.remove('hidden');
		cameraSection.classList.add('hidden');
		tabManual.classList.add('bg-cyan-500', 'text-white');
		tabManual.classList.remove('text-slate-400');
		tabCamera.classList.remove('bg-cyan-500', 'text-white');
		tabCamera.classList.add('text-slate-400');
		resetResult();
	});

	tabCamera.addEventListener('click', () => {
		cameraSection.classList.remove('hidden');
		manualSection.classList.add('hidden');
		tabCamera.classList.add('bg-cyan-500', 'text-white');
		tabCamera.classList.remove('text-slate-400');
		tabManual.classList.remove('bg-cyan-500', 'text-white');
		tabManual.classList.add('text-slate-400');
		resetResult();
	});

	manualSection.addEventListener('submit', (e) => {
		e.preventDefault();
		const input = document.getElementById('plateInput').value;
		processPlate(input);
	});

	document.getElementById('uploadBtn').addEventListener('click', () => {
		document.getElementById('cameraInput').click();
	});

	document.getElementById('cameraInput').addEventListener('change', async (event) => {
		const file = event.target.files[0];
		if (!file) return;

		const reader = new FileReader();
		reader.onload = async (e) => {
			const img = document.getElementById('previewImg');
			img.src = e.target.result;
			img.classList.remove('hidden');

			document.getElementById('loadingOcr').classList.remove('hidden');
			document.getElementById('loadingOcr').classList.add('flex');
			resetResult();

			try {
				const { data } = await Tesseract.recognize(file, 'spa', {
					logger: (m) => console.log(m),
				});

				const rawText = data.text.replace(/\s/g, '').toUpperCase();
				const match = rawText.match(/\d{4}[A-Z]{3}/);

				if (match) {
					processPlate(match[0]);
				} else {
					alert(
						'No se pudo detectar una matrícula válida (4 números y 3 letras). Intenta hacer una foto más nítida.',
					);
				}
			} catch (error) {
				alert('Error al procesar la imagen.');
			} finally {
				document.getElementById('loadingOcr').classList.add('hidden');
				document.getElementById('loadingOcr').classList.remove('flex');
			}
		};
		reader.readAsDataURL(file);
	});

	function processPlate(plate) {
		const cleanPlate = plate.toUpperCase().trim();
		const resultContainer = document.getElementById('resultContainer');

		if (cleanPlate.length !== 7 || !/^\d{4}[A-Z]{3}$/.test(cleanPlate)) {
			alert('Formato inválido. Debe ser 4 números y 3 letras (Ej: 9932AZG).');
			return;
		}

		try {
			const finalNumber = window.calculatePlate(cleanPlate);

			document.getElementById('resultNumber').innerText = finalNumber;
			document.getElementById('platePreview').innerText = `Matrícula analizada: ${cleanPlate}`;

			resultContainer.classList.remove('hidden');
			resultContainer.classList.remove('fade-in');
			void resultContainer.offsetWidth;
			resultContainer.classList.add('fade-in');
		} catch (error) {
			console.error(error);
			alert(error.message);
		}
	}

	function resetResult() {
		document.getElementById('resultContainer').classList.add('hidden');
		document.getElementById('plateInput').value = '';
	}
</script>
