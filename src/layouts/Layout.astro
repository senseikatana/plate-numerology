---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'NumPlate | Calculadora Matrículas',
  description = 'Calculadora numérica de matrículas: descubre el número de tu matrícula española (4 números + 3 letras).',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="text-slate-200 flex items-center justify-center p-4">
    <slot />
  </body>
</html>
