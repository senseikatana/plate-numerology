{
  "name": "plate-numerology",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "nub@0.8.3",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.8.3",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:pages": "STATIC_BUILD=1 ASTRO_BASE=/plate-numerology/ astro build",
    "preview": "wrangler dev --assets ./dist/client",
    "deploy": "astro build && wrangler deploy --assets ./dist/client",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nubjs/types": ">=0.4.13 <=0.8.3",
    "@types/node": "^26.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "author": "senseikatana - Sergio Jurado",
  "description": "Proyecto plate-numerology",
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/vue": "^7.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.24"
  }
}
