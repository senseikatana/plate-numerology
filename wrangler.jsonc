{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "plate-numerology",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "senseikatana.com/numplate/*", "zone_name": "senseikatana.com" },
		{ "pattern": "www.senseikatana.com/numplate/*", "zone_name": "senseikatana.com" }
	],
	"observability": {
		"enabled": true
	}
}